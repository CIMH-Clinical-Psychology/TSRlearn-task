        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === &quot;german&quot;)) {&amp;#10;    instruction_rest_start.text = &quot;Es folgt eine 5-min\u00fctige Ruhephase.\nWir m\u00f6chten messen, wie Ihr Gehirn arbeitet,\nwenn Sie gerade keine Aufgabe bearbeiten.\nDiese Ruhephasen sind f\u00fcr unsere Studie sehr wichtig.\nBitte bleiben Sie dabei wach und halten Sie Kopf und K\u00f6rper\nm\u00f6glichst still.\n\n[Dr\u00fccken Sie eine beliebige Taste, um fortzufahren.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;english&quot;)) {&amp;#10;    instruction_rest_start.text = &quot;A 5-minute rest period will follow.\nWe would like to measure how your brain works\nwhen you are not doing a task.\nThese rest periods are very important for our study.\nPlease stay awake and keep your head and body\nas still as possible.\n\n[Press any key to continue.]&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language == &quot;german&quot;: &amp;#10;    instruction_rest_start.text = (&amp;#10;      &quot;Es folgt eine 5-minütige Ruhephase.\n&quot;&amp;#10;    &quot;Wir möchten messen, wie Ihr Gehirn arbeitet,\n&quot;&amp;#10;    &quot;wenn Sie gerade keine Aufgabe bearbeiten.\n&quot;&amp;#10;    &quot;Diese Ruhephasen sind für unsere Studie sehr wichtig.\n&quot;&amp;#10;    &quot;Bitte bleiben Sie dabei wach und halten Sie Kopf und Körper\n&quot;&amp;#10;    &quot;möglichst still.\n&quot;&amp;#10;    &quot;\n&quot;&amp;#10;    &quot;[Drücken Sie eine beliebige Taste, um fortzufahren.]&quot;&amp;#10;    )&amp;#10;    &amp;#10;if language == &quot;english&quot;: &amp;#10;    instruction_rest_start.text = (&amp;#10;            &quot;A 5-minute rest period will follow.\n&quot;&amp;#10;    &quot;We would like to measure how your brain works\n&quot;&amp;#10;    &quot;when you are not doing a task.\n&quot;&amp;#10;    &quot;These rest periods are very important for our study.\n&quot;&amp;#10;    &quot;Please stay awake and keep your head and body\n&quot;&amp;#10;    &quot;as still as possible.\n&quot;&amp;#10;    &quot;\n&quot;&amp;#10;    &quot;[Press any key to continue.]&quot;&amp;#10;    )&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
