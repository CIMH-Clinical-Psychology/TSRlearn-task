        <Param val="trigger_numbers_dict = {&quot;start/end&quot;: 255, &quot;rest state start&quot;: 160, &quot;rest state end&quot;: 161};&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
