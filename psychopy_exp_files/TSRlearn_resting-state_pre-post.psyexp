        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === &quot;german&quot;)) {&amp;#10;    instruction_rest2.text = &quot;Dr\u00fccken Sie eine beliebige Taste und schlie\u00dfen Sie dann die Augen.\nLassen Sie Ihre Gedanken frei schweifen.\n\nWir sagen Ihnen Bescheid, wenn die 5 Minuten vorbei sind.\n[Dr\u00fccken Sie eine beliebige Taste, um die Ruhephase zu beginnen.]&quot;;&amp;#10;}&amp;#10;if ((language === &quot;english&quot;)) {&amp;#10;    instruction_rest2.text = &quot;Press any key, then close your eyes.\nLet your thoughts wander freely.\n\nWe will let you know when the 5 minutes are over.\n[Press any key to begin the rest period.]&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language == &quot;german&quot;: &amp;#10;    instruction_rest2.text = (&amp;#10;         &quot;Drücken Sie eine beliebige Taste und schließen Sie dann die Augen.\n&quot;&amp;#10;    &quot;Lassen Sie Ihre Gedanken frei schweifen.\n&quot;&amp;#10;    &quot;\n&quot;&amp;#10;    &quot;Wir sagen Ihnen Bescheid, wenn die 5 Minuten vorbei sind.&quot;&amp;#10;    &quot;\n&quot;&amp;#10;    &quot;[Drücken Sie eine beliebige Taste, um die Ruhephase zu beginnen.]&quot;&amp;#10;    )&amp;#10;    &amp;#10;if language == &quot;english&quot;: &amp;#10;        instruction_rest2.text = (&amp;#10;        &quot;Press any key, then close your eyes.\n&quot;&amp;#10;    &quot;Let your thoughts wander freely.\n&quot;&amp;#10;    &quot;\n&quot;&amp;#10;    &quot;We will let you know when the 5 minutes are over.&quot;&amp;#10;    &quot;\n&quot;&amp;#10;    &quot;[Press any key to begin the rest period.]&quot;&amp;#10;    )&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
