        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="bids.trigger(trigger_numbers_dict[&quot;rest state start&quot;], {&quot;label&quot;: &quot;rest_start&quot;, &quot;on_flip&quot;: false});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="bids.trigger(trigger_numbers_dict[&quot;rest state start&quot;], label=&quot;rest_start&quot;, on_flip=False)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
