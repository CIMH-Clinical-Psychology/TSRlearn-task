      <CodeComponent name="functions_imports" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="&amp;#10;# log function that saves variables to log file&amp;#10;def log(*msgs, sep=' ', end='\n'):&amp;#10;    log_file = u'data/%s_%s_%s' % (expInfo['participant'], expName, expInfo['date'] + '_print.log')&amp;#10;    print(*msgs, sep=sep, end=end, flush=True)&amp;#10;&amp;#10;    # Append to log file&amp;#10;    with open(log_file, 'a') as f:&amp;#10;        f.write(sep.join(str(msg) for msg in msgs) + end)&amp;#10;&amp;#10;&amp;#10;import meg_triggers&amp;#10;from meg_triggers import send_trigger&amp;#10;meg_triggers.set_default_duration(0.005)&amp;#10;meg_triggers.set_default_reset_value(0)  # set the value the trigger channel returns to for neutral state&amp;#10;meg_triggers.enable_printing()     " valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="functions_imports" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="exp_settings" plugin="None">
        <Param val="&amp;#10;&amp;#10;# response - key mapping&amp;#10;left_key = 'g'&amp;#10;right_key = 'b'&amp;#10;center_key = 'r'&amp;#10;down_key = 'y'&amp;#10;&amp;#10;possible_keys = [left_key, right_key, center_key, down_key]&amp;#10;&amp;#10;# language for instruction&amp;#10;language = 'german' # 'english', 'french' or 'german' &amp;#10;&amp;#10;font_name = &quot;Sans Sherif&quot;&amp;#10;&amp;#10;rest_dur = 300" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="left_key = &quot;g&quot;;&amp;#10;right_key = &quot;b&quot;;&amp;#10;center_key = &quot;r&quot;;&amp;#10;down_key = &quot;y&quot;;&amp;#10;possible_keys = [left_key, right_key, center_key, down_key];&amp;#10;language = &quot;german&quot;;&amp;#10;font_name = &quot;Sans Sherif&quot;;&amp;#10;rest_dur = 300;&amp;#10;" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="&amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="exp_settings" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="bids_logging_functions" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# --- BIDS event logger with trigger logging ---&amp;#10;# Drop-in replacement for the 'Begin Experiment' code of `bids_logging_functions`.&amp;#10;#&amp;#10;# Time base: everything is globalClock, the same clock win.getFutureFlipTime()&amp;#10;# uses, so tStartRefresh and trigger timestamps are directly comparable.&amp;#10;# Onsets are expressed relative to t0 (logger creation), so they start near 0.&amp;#10;&amp;#10;from pathlib import Path&amp;#10;import csv&amp;#10;import atexit&amp;#10;&amp;#10;import numpy as np&amp;#10;&amp;#10;# NOTE: do NOT import STARTED / FINISHED / core here.&amp;#10;# Builder pastes this block inside run(), so an import would make those names&amp;#10;# local to run() and break `thisExp.status = STARTED` at the top of the&amp;#10;# function (UnboundLocalError). They are already available module-level.&amp;#10;&amp;#10;&amp;#10;class BIDSLogger:&amp;#10;    def __init__(self, win, clock, default_cols=None,&amp;#10;                 send_fn=None, log_trigger_rows=True):&amp;#10;        &quot;&quot;&quot;&amp;#10;        win              : the PsychoPy window (needed for callOnFlip)&amp;#10;        clock            : globalClock - MUST be the same clock the window uses&amp;#10;        send_fn          : the actual trigger function, e.g. meg_triggers.send_trigger&amp;#10;        log_trigger_rows : if True, every trigger also gets its own row&amp;#10;        &quot;&quot;&quot;&amp;#10;        self.win = win&amp;#10;        self.clock = clock&amp;#10;        self.send_fn = send_fn&amp;#10;        self.log_trigger_rows = log_trigger_rows&amp;#10;&amp;#10;        self.rows = []&amp;#10;        self.active = {}      # stim -&gt; row index (open, awaiting offset)&amp;#10;        self.pending = {}     # stim -&gt; trigger fired before its row existed&amp;#10;        self.defaults = default_cols or {}&amp;#10;        if clock is None:&amp;#10;            raise ValueError(&quot;BIDSLogger needs the clock used by the window &quot;&amp;#10;                             &quot;(globalClock), otherwise onsets and triggers &quot;&amp;#10;                             &quot;end up on different time bases.&quot;)&amp;#10;        self.t0 = self.now()&amp;#10;&amp;#10;        self.col_order = [&amp;#10;            &quot;subject&quot;, &quot;block_num&quot;, &quot;trial_num&quot;,&amp;#10;            &quot;component_label&quot;, &quot;onset&quot;, &quot;duration&quot;,&amp;#10;            &quot;type_of_stimulus&quot;, &quot;concept_label&quot;,&amp;#10;            &quot;concept_examplar&quot;,&amp;#10;            &quot;trigger_value&quot;, &quot;trigger_onset&quot;, &quot;trigger_delay&quot;,&amp;#10;            &quot;response_time&quot;, &quot;press_onset_est&quot;, &quot;response&quot;,&amp;#10;            &quot;expected_response&quot;, &quot;wrd_img_match&quot;,&amp;#10;            &quot;correct&quot;,&amp;#10;        ]&amp;#10;&amp;#10;    # ------------------------------------------------------------ timing --&amp;#10;    def now(self):&amp;#10;        &quot;&quot;&quot;&amp;#10;        Current time on the SAME clock as tStartRefresh.&amp;#10;&amp;#10;        tStartRefresh comes from win.getFutureFlipTime(clock=None), which&amp;#10;        returns times on logging.defaultClock - and run() sets that to&amp;#10;        globalClock. Using core.getTime() here instead would be offset by the&amp;#10;        gap between PsychoPy import and globalClock creation (dialog + window&amp;#10;        setup), which can be tens of seconds.&amp;#10;&amp;#10;        format='float' is required because globalClock is created with an ISO&amp;#10;        strftime format, so a bare getTime() returns a string.&amp;#10;        &quot;&quot;&quot;&amp;#10;        return float(self.clock.getTime(format='float'))&amp;#10;&amp;#10;    def _rel(self, t):&amp;#10;        &quot;&quot;&quot;Convert absolute time to onset relative to experiment start.&quot;&quot;&quot;&amp;#10;        return float(t - self.t0)&amp;#10;&amp;#10;    # ------------------------------------------------------- stimulus log --&amp;#10;    def schedule_onset(self, stim, **extra_cols):&amp;#10;        &quot;&quot;&quot;Call every frame; logs on the first frame the stim is STARTED.&quot;&quot;&quot;&amp;#10;        if getattr(stim, &quot;status&quot;, None) == STARTED and stim not in self.active:&amp;#10;            t_on = getattr(stim, &quot;tStartRefresh&quot;, None)&amp;#10;            if t_on is None:&amp;#10;                t_on = self.now()&amp;#10;&amp;#10;            row = {&quot;onset&quot;: self._rel(t_on), &quot;duration&quot;: np.nan}&amp;#10;            row.update(self.defaults)&amp;#10;            row.update(extra_cols)&amp;#10;&amp;#10;            # a trigger for this stim may have fired before the row existed&amp;#10;            trig = self.pending.pop(stim, None)&amp;#10;            if trig is not None:&amp;#10;                self._attach_trigger(row, trig[&quot;value&quot;], trig[&quot;t&quot;])&amp;#10;&amp;#10;            self.rows.append(row)&amp;#10;            self.active[stim] = len(self.rows) - 1&amp;#10;&amp;#10;    def mark_offset(self, stim):&amp;#10;        &quot;&quot;&quot;Call in End Routine; closes the row and computes duration.&quot;&quot;&quot;&amp;#10;        if getattr(stim, &quot;status&quot;, None) == FINISHED and stim in self.active:&amp;#10;            idx = self.active.pop(stim)&amp;#10;            t_off = getattr(stim, &quot;tStopRefresh&quot;, None)&amp;#10;            if t_off is None:&amp;#10;                t_off = self.now()&amp;#10;            self.rows[idx][&quot;duration&quot;] = self._rel(t_off) - self.rows[idx][&quot;onset&quot;]&amp;#10;        else:&amp;#10;            # stim never finished cleanly (e.g. routine force-ended):&amp;#10;            # drop it from active so the next trial can reopen it&amp;#10;            self.active.pop(stim, None)&amp;#10;&amp;#10;    def close_trial(self):&amp;#10;        &quot;&quot;&quot;&amp;#10;        Call in the End Routine of the last routine of each trial (ITI).&amp;#10;&amp;#10;        Some components never reach FINISHED - e.g. spoken_word, when the&amp;#10;        routine is ended by the feedback logic before the audio has played&amp;#10;        out. Without this, they stay in `active` forever and every later&amp;#10;        schedule_onset() for them is silently skipped.&amp;#10;        &quot;&quot;&quot;&amp;#10;        t_now = self.now()&amp;#10;        for stim, idx in list(self.active.items()):&amp;#10;            if np.isnan(self.rows[idx].get(&quot;duration&quot;, np.nan)):&amp;#10;                # component was cut short: mark duration up to now, and flag it&amp;#10;                self.rows[idx][&quot;duration&quot;] = self._rel(t_now) - self.rows[idx][&quot;onset&quot;]&amp;#10;                self.rows[idx][&quot;truncated&quot;] = 1&amp;#10;        self.active.clear()&amp;#10;        # a trigger queued for a stim whose row never appeared would otherwise&amp;#10;        # be back-filled onto the *next* trial's row&amp;#10;        self.pending.clear()&amp;#10;&amp;#10;    def add_instant(self, trial_type, onset=None, **extra_cols):&amp;#10;        &quot;&quot;&quot;&amp;#10;        One-shot event with no duration, e.g. a button press.&amp;#10;&amp;#10;        onset : absolute time on self.clock. Pass this for anything logged&amp;#10;                later than it happened - a response logged in End Routine&amp;#10;                should use key_resp.tStartRefresh + key_resp.rt, not the&amp;#10;                time End Routine happens to run.&amp;#10;        &quot;&quot;&quot;&amp;#10;        t = self.now() if onset is None else float(onset)&amp;#10;        row = {&quot;onset&quot;: self._rel(t), &quot;duration&quot;: 0.0,&amp;#10;               &quot;type_of_stimulus&quot;: trial_type}&amp;#10;        row.update(self.defaults)&amp;#10;        row.update(extra_cols)&amp;#10;        self.rows.append(row)&amp;#10;&amp;#10;    # -------------------------------------------------------- trigger log --&amp;#10;    def trigger(self, value, stim=None, label=None, on_flip=True, **extra):&amp;#10;        &quot;&quot;&quot;&amp;#10;        Send a trigger and log when it was sent.&amp;#10;&amp;#10;        stim     : link the trigger to this stimulus's row, adding&amp;#10;                   trigger_value / trigger_onset / trigger_delay to it&amp;#10;        label    : component_label for the standalone trigger row&amp;#10;        on_flip  : True  -&gt; fire via win.callOnFlip, i.e. immediately after the&amp;#10;                            buffer swap. Use for anything screen-locked.&amp;#10;                   False -&gt; fire right now. Use for responses and for triggers&amp;#10;                            at the very end of a routine.&amp;#10;        &quot;&quot;&quot;&amp;#10;        value = int(value)&amp;#10;&amp;#10;        def _fire():&amp;#10;            t = self.now()                    # timestamp before the send&amp;#10;            if self.send_fn is not None:&amp;#10;                self.send_fn(value)&amp;#10;            self._record_trigger(value, t, stim=stim, label=label, **extra)&amp;#10;&amp;#10;        if on_flip and self.win is not None:&amp;#10;            self.win.callOnFlip(_fire)&amp;#10;        else:&amp;#10;            _fire()&amp;#10;&amp;#10;    def _attach_trigger(self, row, value, t_abs):&amp;#10;        row[&quot;trigger_value&quot;] = value&amp;#10;        row[&quot;trigger_onset&quot;] = self._rel(t_abs)&amp;#10;        row[&quot;trigger_delay&quot;] = row[&quot;trigger_onset&quot;] - row[&quot;onset&quot;]&amp;#10;&amp;#10;    def _record_trigger(self, value, t_abs, stim=None, label=None, **extra):&amp;#10;        if stim is not None:&amp;#10;            if stim in self.active:&amp;#10;                self._attach_trigger(self.rows[self.active[stim]], value, t_abs)&amp;#10;            else:&amp;#10;                # row not created yet -&gt; back-fill on the next schedule_onset&amp;#10;                self.pending[stim] = {&quot;value&quot;: value, &quot;t&quot;: t_abs}&amp;#10;&amp;#10;        if self.log_trigger_rows:&amp;#10;            row = {&quot;onset&quot;: self._rel(t_abs), &quot;duration&quot;: 0.0,&amp;#10;                   &quot;type_of_stimulus&quot;: &quot;trigger&quot;,&amp;#10;                   &quot;component_label&quot;: label or &quot;trigger&quot;,&amp;#10;                   &quot;trigger_value&quot;: value}&amp;#10;            row.update(self.defaults)&amp;#10;            row.update(extra)&amp;#10;            self.rows.append(row)&amp;#10;&amp;#10;    # -------------------------------------------------------------- output --&amp;#10;    def save(self, filename_base):&amp;#10;        out = Path(filename_base).with_suffix(&quot;&quot;)&amp;#10;        out = out.parent / (out.name + &quot;_events.tsv&quot;)&amp;#10;&amp;#10;        all_keys = list(self.col_order)&amp;#10;        for r in self.rows:&amp;#10;            for k in r.keys():&amp;#10;                if k not in all_keys:&amp;#10;                    all_keys.append(k)&amp;#10;&amp;#10;        # BIDS requires onset-sorted rows; sort a copy so live indices stay valid&amp;#10;        rows_sorted = sorted(self.rows, key=lambda r: r.get(&quot;onset&quot;, 0.0))&amp;#10;&amp;#10;        with open(out, &quot;w&quot;, newline=&quot;&quot;, encoding=&quot;utf-8&quot;) as f:&amp;#10;            w = csv.DictWriter(f, fieldnames=all_keys, delimiter=&quot;\t&quot;,&amp;#10;                               extrasaction=&quot;ignore&quot;)&amp;#10;            w.writeheader()&amp;#10;            for r in rows_sorted:&amp;#10;                out_row = {}&amp;#10;                for k in all_keys:&amp;#10;                    v = r.get(k)&amp;#10;                    if v is None or (isinstance(v, float) and np.isnan(v)):&amp;#10;                        out_row[k] = &quot;n/a&quot;&amp;#10;                    else:&amp;#10;                        out_row[k] = v&amp;#10;                w.writerow(out_row)&amp;#10;&amp;#10;        return str(out)&amp;#10;&amp;#10;    def trigger_report(self):&amp;#10;        &quot;&quot;&quot;Quick console summary of stimulus-to-trigger delays, per label.&quot;&quot;&quot;&amp;#10;        from collections import defaultdict&amp;#10;        by_label = defaultdict(list)&amp;#10;        for r in self.rows:&amp;#10;            if r.get(&quot;trigger_delay&quot;) is not None and r.get(&quot;type_of_stimulus&quot;) != &quot;trigger&quot;:&amp;#10;                by_label[r.get(&quot;component_label&quot;, &quot;?&quot;)].append(r[&quot;trigger_delay&quot;] * 1000)&amp;#10;        lines = []&amp;#10;        for lab, d in sorted(by_label.items()):&amp;#10;            d = np.asarray(d)&amp;#10;            lines.append(f&quot;{lab:&gt;24s}  n={len(d):4d}  &quot;&amp;#10;                         f&quot;median={np.median(d):6.2f} ms  &quot;&amp;#10;                         f&quot;IQR=[{np.percentile(d,25):.2f}, {np.percentile(d,75):.2f}]  &quot;&amp;#10;                         f&quot;max={d.max():6.2f}&quot;)&amp;#10;        return &quot;\n&quot;.join(lines) if lines else &quot;no linked triggers logged&quot;&amp;#10;&amp;#10;&amp;#10;bids = None&amp;#10;&amp;#10;&amp;#10;def _bids_autosave():&amp;#10;    try:&amp;#10;        if bids and hasattr(bids, &quot;rows&quot;):&amp;#10;            out = bids.save(thisExp.dataFileName)&amp;#10;            print(f&quot;[autosave] BIDS events written to: {out}&quot;)&amp;#10;            print(bids.trigger_report())&amp;#10;    except Exception as e:&amp;#10;        print(f&quot;[autosave] Failed to save BIDS events: {e}&quot;)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="bids = new BIDSLogger({&quot;win&quot;: psychoJS.window, &quot;clock&quot;: globalClock, &quot;send_fn&quot;: send_trigger, &quot;default_cols&quot;: dict({&quot;subject&quot;: expInfo.get(&quot;participant&quot;)})});&amp;#10;_ = bids.save(psychoJS.experiment.dataFileName);&amp;#10;atexit.register(_bids_autosave);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# ---- Create the logger once ----&amp;#10;#bids = BIDSLogger(&amp;#10;    #win=win,&amp;#10;    #clock=globalClock,&amp;#10;    #default_cols=dict(&amp;#10;        #subject=expInfo.get(&quot;participant&quot;)&amp;#10;    #)&amp;#10;#)&amp;#10;&amp;#10;bids = BIDSLogger(&amp;#10;    win=win,&amp;#10;    clock=globalClock,&amp;#10;    send_fn=send_trigger,&amp;#10;    default_cols=dict(subject=expInfo.get(&quot;participant&quot;))&amp;#10;)&amp;#10;&amp;#10;# write a header-only file immediately so each start creates a file&amp;#10;_ = bids.save(thisExp.dataFileName)&amp;#10;&amp;#10;# atexit autosave: runs on normal finish AND on ESC (core.quit)&amp;#10;atexit.register(_bids_autosave)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="bids_logging_functions" valType="code" updates="None" name="name"/>
      </CodeComponent>
