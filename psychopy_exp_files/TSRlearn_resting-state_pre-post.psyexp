        <Param val="bids.trigger(trigger_numbers_dict[&quot;rest state end&quot;], {&quot;label&quot;: &quot;rest_end&quot;, &quot;on_flip&quot;: false});&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="bids.trigger(trigger_numbers_dict[&quot;rest state end&quot;], label=&quot;rest_end&quot;, on_flip=False)" valType="extendedCode" updates="constant" name="End Routine"/>
