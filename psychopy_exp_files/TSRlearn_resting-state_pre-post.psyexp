        <Param val="&amp;#10;#send_trigger(value=trigger_numbers_dict[&quot;start/end&quot;])&amp;#10;bids.trigger(trigger_numbers_dict[&quot;start/end&quot;], label=&quot;exp_start&quot;, on_flip=False)" valType="extendedCode" updates="constant" name="Begin Routine"/>
