        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    text_break_block.text = &quot;This ia a task break.\nYou can relax for as long as you need\n\nIf you are ready to continue, please press any button.&quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    text_break_block.text = &quot;Die Pause hat begonnen.\nSie k\u00f6nnen sich so lange ausruhen, wie sie es brauchen\n\nWenn Sie bereit sind, weiterzumachen, dr\u00fccken Sie bitte eine beliebige Taste.&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
