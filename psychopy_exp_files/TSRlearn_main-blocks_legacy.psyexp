      <CodeComponent name="refine_positions" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="POS = {&quot;left&quot;: left_pos, &quot;center&quot;: center_pos, &quot;right&quot;: right_pos};&amp;#10;pos_to_key = {[right_pos]: right_key, [center_pos]: center_key, [left_pos]: left_key};&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# make coordinates match with position description in excel file &amp;#10;POS = {&amp;#10;    'left':   left_pos,&amp;#10;    'center': center_pos,&amp;#10;    'right':  right_pos&amp;#10;}&amp;#10;&amp;#10;# Map positions to keys&amp;#10;# (just so it's easier to access later)&amp;#10;posToKey = {&amp;#10;    right_pos: right_key,&amp;#10;    center_pos: center_key,&amp;#10;    left_pos: left_key&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="refine_positions" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="function_definitions_js" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="/**&amp;#10; * Return an [x, y] pair from various spreadsheet formats.&amp;#10; *&amp;#10; * Supported inputs:&amp;#10; *  - [x, y] array&amp;#10; *  - keyword string that exists in POS (e.g., &quot;left_pos&quot;)&amp;#10; *  - string literal like &quot;(-0.4, 0.2)&quot;, &quot;[-0.4, 0.2]&quot;, &quot;-0.4, 0.2&quot;&amp;#10; *&amp;#10; * @param {any} val&amp;#10; * @param {Record&lt;string, [number, number]&gt;} POS&amp;#10; * @returns {[number, number]}&amp;#10; */&amp;#10;window.resolve_pos = function(val, POS) {&amp;#10;  // Already an array -&gt; normalize to [x, y]&amp;#10;  if (Array.isArray(val)) {&amp;#10;    if (val.length !== 2) {&amp;#10;      throw new TypeError(`Position array must have length 2, got ${val.length}`);&amp;#10;    }&amp;#10;    return [Number(val[0]), Number(val[1])];&amp;#10;  }&amp;#10;&amp;#10;  // Name like &quot;left_pos&quot; -&gt; look up, or parse a literal string&amp;#10;  if (typeof val === &quot;string&quot;) {&amp;#10;    const name = val.trim();&amp;#10;&amp;#10;    if (Object.prototype.hasOwnProperty.call(POS, name)) {&amp;#10;      return POS[name];&amp;#10;    }&amp;#10;&amp;#10;    // Parse literals like &quot;(-0.4, 0.2)&quot; or &quot;[-0.4, 0.2]&quot; or &quot;-0.4, 0.2&quot;&amp;#10;    const parsed = parseXYLiteral(name);&amp;#10;    if (parsed) return parsed;&amp;#10;&amp;#10;    throw new Error(`Unrecognized position value: ${JSON.stringify(val)}`);&amp;#10;  }&amp;#10;&amp;#10;  throw new TypeError(`Unsupported position type: ${Object.prototype.toString.call(val)}`);&amp;#10;}&amp;#10;&amp;#10;&amp;#10;&amp;#10;/**&amp;#10; * Parse a simple &quot;(x, y)&quot; / &quot;[x, y]&quot; / &quot;x, y&quot; string into [x, y].&amp;#10; * Returns null if it doesn't match.&amp;#10; *&amp;#10; * @param {string} s&amp;#10; * @returns {[number, number] | null}&amp;#10; */&amp;#10;function parseXYLiteral(s) {&amp;#10;  // Remove surrounding brackets/parens if present&amp;#10;  let t = s.trim();&amp;#10;&amp;#10;  // Allow surrounding () or []&amp;#10;  if (&amp;#10;    (t.startsWith(&quot;(&quot;) &amp;&amp; t.endsWith(&quot;)&quot;)) ||&amp;#10;    (t.startsWith(&quot;[&quot;) &amp;&amp; t.endsWith(&quot;]&quot;))&amp;#10;  ) {&amp;#10;    t = t.slice(1, -1).trim();&amp;#10;  }&amp;#10;&amp;#10;  // Split on comma&amp;#10;  const parts = t.split(&quot;,&quot;).map(p =&gt; p.trim());&amp;#10;  if (parts.length !== 2) return null;&amp;#10;&amp;#10;  const x = Number(parts[0]);&amp;#10;  const y = Number(parts[1]);&amp;#10;&amp;#10;  // Ensure both are valid finite numbers&amp;#10;  if (!Number.isFinite(x) || !Number.isFinite(y)) return null;&amp;#10;&amp;#10;  return [x, y];&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="True" valType="bool" updates="None" name="disabled"/>
        <Param val="function_definitions_js" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="set_arc_img_pos" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="import math&amp;#10;&amp;#10;# The arc is centered on the prompt, so every top image is exactly `r` from it.&amp;#10;cx, cy = prompt_pos&amp;#10;r = 0.25        # distance of every top image from the prompt &amp;#10;spread_deg = 45   # how far left/right swing from straight-up &amp;#10;&amp;#10;def _on_arc(angle_deg):&amp;#10;    a = math.radians(angle_deg)&amp;#10;    return (cx + r * math.cos(a), cy + r * math.sin(a))&amp;#10;&amp;#10;# 90 deg = straight up above the prompt; symmetric left/right around it&amp;#10;center_pos = _on_arc(90)&amp;#10;left_pos   = _on_arc(90 + spread_deg)&amp;#10;right_pos  = _on_arc(90 - spread_deg)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import * as math from 'math';&amp;#10;[cx, cy] = prompt_pos;&amp;#10;r = 0.25;&amp;#10;spread_deg = 45;&amp;#10;function _on_arc(angle_deg) {&amp;#10;    var a;&amp;#10;    a = math.radians(angle_deg);&amp;#10;    return [(cx + (r * Math.cos(a))), (cy + (r * Math.sin(a)))];&amp;#10;}&amp;#10;center_pos = _on_arc(90);&amp;#10;left_pos = _on_arc((90 + spread_deg));&amp;#10;right_pos = _on_arc((90 - spread_deg));&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="set_arc_img_pos" valType="code" updates="None" name="name"/>
      </CodeComponent>
