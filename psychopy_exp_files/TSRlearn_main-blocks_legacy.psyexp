        <Param val="function_definitions" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="exp_settings" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="## set main experimental variables&amp;#10;&amp;#10;# set exp ppt id&amp;#10;participant_ID = expInfo['participant_ID']&amp;#10;&amp;#10;# instruction language&amp;#10;language = &quot;german&quot; # &quot;french&quot; or &quot;english&quot;&amp;#10;font_name = &quot;Sans Sherif&quot;&amp;#10;&amp;#10;# &quot;Left&quot; &quot;right&quot; etc. are the arrow keys on the key board&amp;#10;# these are the keys for selecting the images in different positions&amp;#10;left_key = &quot;g&quot;&amp;#10;center_key = &quot;r&quot;&amp;#10;right_key = &quot;b&quot; &amp;#10;down_key = &quot;y&quot;&amp;#10;&amp;#10;# pos of images (x-coord, y-coord)&amp;#10;#left_pos   = (-0.2, 0.1)&amp;#10;#right_pos  = (0.2, 0.1)&amp;#10;#center_pos = (0.0, 0.1)&amp;#10;prompt_pos = (0, -0.15) &amp;#10;&amp;#10;# pos on retrieval trials&amp;#10;leftside_retr = (-0.05,0)&amp;#10;rightside_retr = (0.05,0)&amp;#10;&amp;#10;# pos of instructions to choose the next image&amp;#10;instruc_pos = (0,0.2)&amp;#10;&amp;#10;# response time on learning trials&amp;#10;max_response_time = 5 # [s]&amp;#10; &amp;#10;# feedback on learning trials&amp;#10;feedback_steps  =  0.06   # steps out of 1 (percent)&amp;#10;rest_jump       =  0.004 # abs distance to target pos&amp;#10;animation_time   = 1    # [s]&amp;#10; &amp;#10;# breaks (indicate after which learning route you want task break)&amp;#10;break_after_route = 4&amp;#10;break_dur = 30 # [s]&amp;#10;&amp;#10;# replay breaks during learning&amp;#10;replay_break_dur = 5&amp;#10;trials_per_run = 13 # after 13 trials because we have 14 image sequences&amp;#10;&amp;#10;after_block_restdur = 60&amp;#10;max_durafter_block_break = 180&amp;#10;&amp;#10;# number of learning runs&amp;#10;# one run is 13 trials (learn 14-image sequence in pairs)&amp;#10;n_learn_route = 4&amp;#10;&amp;#10;# duration of response time on retrieval trials&amp;#10;retr_dur = 3 # [s]&amp;#10;&amp;#10;# too slow message duration&amp;#10;too_slow_dur = 0.5 # [s]&amp;#10;&amp;#10;retr_dur_slider = 3 # [s] response time on retrieval questions with slider&amp;#10;instr_newroute_dur = 1 # [s]&amp;#10;image_dur_retr_new = 1&amp;#10;#fix_dur_retr = 0.5 are defined in condition file&amp;#10;&amp;#10;# timing for fast image presentations at the end&amp;#10;fast_img_dur = 0.075 # [s]&amp;#10;mask_dur = 0.05 # [s]&amp;#10;&amp;#10;max_read_dur = 180; &amp;#10;&amp;#10;# default context image&amp;#10;context_img_block = &quot;stimuli/default.png&quot;" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="language = &quot;english&quot;;&amp;#10;left_key = &quot;left&quot;;&amp;#10;center_key = &quot;up&quot;;&amp;#10;right_key = &quot;right&quot;;&amp;#10;down_key = &quot;down&quot;;&amp;#10;left_pos = [(- 0.2), 0.1];&amp;#10;right_pos = [0.2, 0.1];&amp;#10;center_pos = [0.0, 0.1];&amp;#10;prompt_pos = [0, (- 0.1)];&amp;#10;instruc_pos = [0, 0];&amp;#10;max_response_time = 3;&amp;#10;feedback_steps = 0.06;&amp;#10;rest_jump = 0.004;&amp;#10;animation_time = 1.4;&amp;#10;break_after_route = 10;&amp;#10;break_dur = 30;&amp;#10;replay_break_dur = 5;&amp;#10;trials_per_run = 13;&amp;#10;n_learn_route = 6;&amp;#10;retr_dur = 5;&amp;#10;too_slow_dur = 0.5;&amp;#10;retrieval_quest_dur = 5.5;&amp;#10;retr_dur_slider = 5;&amp;#10;instr_newroute_dur = 1;&amp;#10;fast_img_dur = 0.075;&amp;#10;mask_dur = 0.05;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="exp_settings" valType="code" updates="None" name="name"/>
      </CodeComponent>
      <CodeComponent name="bids_logging_functions" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="# --- BIDS event logger with trigger logging (TSRlearn_main-blocks) ---&amp;#10;# Drop-in replacement for the 'Begin Experiment' code of `bids_logging_functions`.&amp;#10;#&amp;#10;# Time base: globalClock, the same clock win.getFutureFlipTime(clock=None) uses,&amp;#10;# so tStartRefresh and trigger timestamps are directly comparable.&amp;#10;# Onsets are relative to t0 (logger creation), so they start near 0.&amp;#10;#&amp;#10;# NOTE: do NOT import STARTED / FINISHED / core here. Builder pastes this block&amp;#10;# inside run(), so an import would make those names local to run() and break&amp;#10;# `thisExp.status = STARTED` at the top of the function (UnboundLocalError).&amp;#10;# Path / csv / numpy / atexit are already imported by `import_packages`.&amp;#10;&amp;#10;&amp;#10;class BIDSLogger:&amp;#10;    def __init__(self, win, clock, default_cols=None,&amp;#10;                 send_fn=None, log_trigger_rows=True):&amp;#10;        &quot;&quot;&quot;&amp;#10;        win              : the PsychoPy window (needed for callOnFlip)&amp;#10;        clock            : globalClock - MUST be the clock the window uses&amp;#10;        send_fn          : meg_triggers.send_trigger&amp;#10;        log_trigger_rows : if True, every trigger also gets its own row&amp;#10;        &quot;&quot;&quot;&amp;#10;        self.win = win&amp;#10;        self.clock = clock&amp;#10;        self.send_fn = send_fn&amp;#10;        self.log_trigger_rows = log_trigger_rows&amp;#10;&amp;#10;        self.rows = []&amp;#10;        self.active = {}      # stim -&gt; row index (open, awaiting offset)&amp;#10;        self.pending = {}     # stim -&gt; trigger fired before its row existed&amp;#10;        self.defaults = default_cols or {}&amp;#10;        if clock is None:&amp;#10;            raise ValueError(&quot;BIDSLogger needs globalClock, otherwise onsets &quot;&amp;#10;                             &quot;and triggers end up on different time bases.&quot;)&amp;#10;        self.t0 = self.now()&amp;#10;&amp;#10;        self.col_order = [&amp;#10;            &quot;subject&quot;, &quot;trial_type&quot;, &quot;block_name&quot;, &quot;sequence_name&quot;,&amp;#10;            &quot;route_num&quot;,&amp;#10;            &quot;trial_num&quot;,&amp;#10;            &quot;component_label&quot;,&amp;#10;            &quot;concept_label&quot;, &quot;concept_exemplar&quot;,&amp;#10;            &quot;onset&quot;, &quot;duration&quot;,&amp;#10;            &quot;type_of_stimulus&quot;,&amp;#10;            &quot;trigger_value&quot;, &quot;trigger_onset&quot;, &quot;trigger_delay&quot;,&amp;#10;            &quot;response_time&quot;, &quot;press_onset_est&quot;, &quot;response&quot;,&amp;#10;            &quot;response_meaning&quot;, &quot;expected_response&quot;,&amp;#10;            &quot;correct&quot;, &quot;distance_correct&quot;,&amp;#10;        ]&amp;#10;&amp;#10;    # ------------------------------------------------------------ timing --&amp;#10;    def now(self):&amp;#10;        &quot;&quot;&quot;Current time on the SAME clock as tStartRefresh.&quot;&quot;&quot;&amp;#10;        return float(self.clock.getTime(format='float'))&amp;#10;&amp;#10;    def _rel(self, t):&amp;#10;        return float(t - self.t0)&amp;#10;&amp;#10;    # ------------------------------------------------------- stimulus log --&amp;#10;    def schedule_onset(self, stim, **extra_cols):&amp;#10;        &quot;&quot;&quot;Call every frame; logs on the first frame the stim is STARTED.&quot;&quot;&quot;&amp;#10;        if getattr(stim, &quot;status&quot;, None) == STARTED and stim not in self.active:&amp;#10;            t_on = getattr(stim, &quot;tStartRefresh&quot;, None)&amp;#10;            if t_on is None:&amp;#10;                t_on = self.now()&amp;#10;&amp;#10;            row = {&quot;onset&quot;: self._rel(t_on), &quot;duration&quot;: np.nan}&amp;#10;            row.update(self.defaults)&amp;#10;            row.update(extra_cols)&amp;#10;&amp;#10;            trig = self.pending.pop(stim, None)&amp;#10;            if trig is not None:&amp;#10;                self._attach_trigger(row, trig[&quot;value&quot;], trig[&quot;t&quot;])&amp;#10;&amp;#10;            self.rows.append(row)&amp;#10;            self.active[stim] = len(self.rows) - 1&amp;#10;&amp;#10;    def mark_offset(self, stim):&amp;#10;        &quot;&quot;&quot;Call in End Routine; closes the row and computes duration.&quot;&quot;&quot;&amp;#10;        if getattr(stim, &quot;status&quot;, None) == FINISHED and stim in self.active:&amp;#10;            idx = self.active.pop(stim)&amp;#10;            t_off = getattr(stim, &quot;tStopRefresh&quot;, None)&amp;#10;            if t_off is None:&amp;#10;                t_off = self.now()&amp;#10;            self.rows[idx][&quot;duration&quot;] = self._rel(t_off) - self.rows[idx][&quot;onset&quot;]&amp;#10;        else:&amp;#10;            # never finished cleanly - free it so the next trial can reopen it&amp;#10;            self.active.pop(stim, None)&amp;#10;&amp;#10;    def close_trial(self):&amp;#10;        &quot;&quot;&quot;&amp;#10;        Call at the end of each trial. Components that never reach FINISHED&amp;#10;        (routine ended early by a response or animation) would otherwise stay&amp;#10;        in `active` forever and every later schedule_onset() for them would be&amp;#10;        silently skipped.&amp;#10;        &quot;&quot;&quot;&amp;#10;        t_now = self.now()&amp;#10;        for stim, idx in list(self.active.items()):&amp;#10;            if np.isnan(self.rows[idx].get(&quot;duration&quot;, np.nan)):&amp;#10;                self.rows[idx][&quot;duration&quot;] = self._rel(t_now) - self.rows[idx][&quot;onset&quot;]&amp;#10;                self.rows[idx][&quot;truncated&quot;] = 1&amp;#10;        self.active.clear()&amp;#10;        self.pending.clear()&amp;#10;&amp;#10;    def add_instant(self, given_name, onset=None, **extra_cols):&amp;#10;        &quot;&quot;&quot;&amp;#10;        One-shot event with no duration, e.g. a button press.&amp;#10;&amp;#10;        onset : absolute time on self.clock. Pass this for anything logged&amp;#10;                later than it happened.&amp;#10;        &quot;&quot;&quot;&amp;#10;        t = self.now() if onset is None else float(onset)&amp;#10;        row = {&quot;onset&quot;: self._rel(t), &quot;duration&quot;: 0.0,&amp;#10;               &quot;type_of_stimulus&quot;: given_name}&amp;#10;        row.update(self.defaults)&amp;#10;        row.update(extra_cols)&amp;#10;        self.rows.append(row)&amp;#10;&amp;#10;    # -------------------------------------------------------- trigger log --&amp;#10;    def trigger(self, value, stim=None, label=None, on_flip=True, **extra):&amp;#10;        &quot;&quot;&quot;&amp;#10;        Send a trigger and log when it was sent.&amp;#10;&amp;#10;        stim     : link the trigger to this stimulus's row, adding&amp;#10;                   trigger_value / trigger_onset / trigger_delay to it&amp;#10;        label    : component_label for the standalone trigger row&amp;#10;        on_flip  : True  -&gt; fire via win.callOnFlip, i.e. immediately after the&amp;#10;                            buffer swap. Use for anything screen-locked.&amp;#10;                   False -&gt; fire right now. Use for responses and for triggers&amp;#10;                            at the very end of a routine.&amp;#10;        &quot;&quot;&quot;&amp;#10;        value = int(value)&amp;#10;&amp;#10;        def _fire():&amp;#10;            t = self.now()                     # timestamp before the send&amp;#10;            try:&amp;#10;                if self.send_fn is not None:&amp;#10;                    self.send_fn(value)&amp;#10;            except Exception as e:&amp;#10;                # never let a port error swallow the remaining flip callbacks&amp;#10;                # (clock.reset / clearEvents are registered on the same flip)&amp;#10;                print(f&quot;[trigger] send failed for {value}: {e}&quot;)&amp;#10;            self._record_trigger(value, t, stim=stim, label=label, **extra)&amp;#10;&amp;#10;        if on_flip and self.win is not None:&amp;#10;            self.win.callOnFlip(_fire)&amp;#10;        else:&amp;#10;            _fire()&amp;#10;&amp;#10;    def _attach_trigger(self, row, value, t_abs):&amp;#10;        row[&quot;trigger_value&quot;] = value&amp;#10;        row[&quot;trigger_onset&quot;] = self._rel(t_abs)&amp;#10;        row[&quot;trigger_delay&quot;] = row[&quot;trigger_onset&quot;] - row[&quot;onset&quot;]&amp;#10;&amp;#10;    def _record_trigger(self, value, t_abs, stim=None, label=None, **extra):&amp;#10;        if stim is not None:&amp;#10;            if stim in self.active:&amp;#10;                self._attach_trigger(self.rows[self.active[stim]], value, t_abs)&amp;#10;            else:&amp;#10;                self.pending[stim] = {&quot;value&quot;: value, &quot;t&quot;: t_abs}&amp;#10;&amp;#10;        if self.log_trigger_rows:&amp;#10;            row = {&quot;onset&quot;: self._rel(t_abs), &quot;duration&quot;: 0.0,&amp;#10;                   &quot;type_of_stimulus&quot;: &quot;trigger&quot;,&amp;#10;                   &quot;component_label&quot;: label or &quot;trigger&quot;,&amp;#10;                   &quot;trigger_value&quot;: value}&amp;#10;            row.update(self.defaults)&amp;#10;            row.update(extra)&amp;#10;            self.rows.append(row)&amp;#10;&amp;#10;    # -------------------------------------------------------------- output --&amp;#10;    def save(self, filename_base):&amp;#10;        out = Path(filename_base).with_suffix(&quot;&quot;)&amp;#10;        out = out.parent / (out.name + &quot;_events.tsv&quot;)&amp;#10;&amp;#10;        all_keys = list(self.col_order)&amp;#10;        for r in self.rows:&amp;#10;            for k in r.keys():&amp;#10;                if k not in all_keys:&amp;#10;                    all_keys.append(k)&amp;#10;&amp;#10;        # BIDS requires onset-sorted rows; sort a copy so live indices stay valid&amp;#10;        rows_sorted = sorted(self.rows, key=lambda r: r.get(&quot;onset&quot;, 0.0))&amp;#10;&amp;#10;        with open(out, &quot;w&quot;, newline=&quot;&quot;, encoding=&quot;utf-8&quot;) as f:&amp;#10;            w = csv.DictWriter(f, fieldnames=all_keys, delimiter=&quot;\t&quot;,&amp;#10;                               extrasaction=&quot;ignore&quot;)&amp;#10;            w.writeheader()&amp;#10;            for r in rows_sorted:&amp;#10;                out_row = {}&amp;#10;                for k in all_keys:&amp;#10;                    v = r.get(k)&amp;#10;                    if v is None or (isinstance(v, float) and np.isnan(v)):&amp;#10;                        out_row[k] = &quot;n/a&quot;&amp;#10;                    else:&amp;#10;                        out_row[k] = v&amp;#10;                w.writerow(out_row)&amp;#10;&amp;#10;        return str(out)&amp;#10;&amp;#10;    def trigger_report(self):&amp;#10;        &quot;&quot;&quot;Console summary of stimulus-to-trigger delays, per label.&quot;&quot;&quot;&amp;#10;        from collections import defaultdict&amp;#10;        by_label = defaultdict(list)&amp;#10;        for r in self.rows:&amp;#10;            if (r.get(&quot;trigger_delay&quot;) is not None&amp;#10;                    and r.get(&quot;type_of_stimulus&quot;) != &quot;trigger&quot;):&amp;#10;                by_label[r.get(&quot;component_label&quot;, &quot;?&quot;)].append(&amp;#10;                    r[&quot;trigger_delay&quot;] * 1000)&amp;#10;        lines = []&amp;#10;        for lab, d in sorted(by_label.items()):&amp;#10;            d = np.asarray(d)&amp;#10;            lines.append(f&quot;{lab:&gt;24s}  n={len(d):4d}  &quot;&amp;#10;                         f&quot;median={np.median(d):7.3f} ms  &quot;&amp;#10;                         f&quot;IQR=[{np.percentile(d,25):.3f}, {np.percentile(d,75):.3f}]  &quot;&amp;#10;                         f&quot;max={d.max():7.3f}&quot;)&amp;#10;        return &quot;\n&quot;.join(lines) if lines else &quot;no linked triggers logged&quot;&amp;#10;&amp;#10;&amp;#10;bids = None&amp;#10;&amp;#10;&amp;#10;def _bids_autosave():&amp;#10;    try:&amp;#10;        if bids and hasattr(bids, &quot;rows&quot;):&amp;#10;            out = bids.save(thisExp.dataFileName)&amp;#10;            print(f&quot;[autosave] BIDS events written to: {out}&quot;)&amp;#10;            print(bids.trigger_report())&amp;#10;    except Exception as e:&amp;#10;        print(f&quot;[autosave] Failed to save BIDS events: {e}&quot;)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="/* Syntax Error: Fix Python code */" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="# Create the logger once&amp;#10;bids = BIDSLogger(&amp;#10;    win=win,&amp;#10;    clock=globalClock,&amp;#10;    send_fn=send_trigger,&amp;#10;    default_cols=dict(subject=expInfo.get(&quot;participant_ID&quot;))&amp;#10;)&amp;#10;&amp;#10;# write a header-only file immediately so each start creates a file&amp;#10;_ = bids.save(thisExp.dataFileName)&amp;#10;&amp;#10;# atexit autosave: runs on normal finish AND on ESC (core.quit)&amp;#10;atexit.register(_bids_autosave)" valType="extendedCode" updates="constant" name="Begin Routine"/>
