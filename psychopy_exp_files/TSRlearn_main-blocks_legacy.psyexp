        <Param val="&amp;#10;if language == &quot;french&quot;:&amp;#10;    instruction_text_newroute_2.text = (&quot;Vous allez maintenant réapprendre les associations entre les images.&quot;)&amp;#10;if language == &quot;english&quot;:&amp;#10;    instruction_text_newroute_2.text = (&quot;The learning of associations will continue now.&quot;)&amp;#10;if language == &quot;german&quot;: &amp;#10;    instruction_text_newroute_2.text = (&quot;Jetzt geht das Assoziationslernen weiter.&quot;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
