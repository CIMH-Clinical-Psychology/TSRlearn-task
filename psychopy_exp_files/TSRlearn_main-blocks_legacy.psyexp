        <Param val="pressed = resp.keys;&amp;#10;if ((pressed instanceof list)) {&amp;#10;    pressed = (pressed ? pressed.slice((- 1))[0] : &quot;m&quot;);&amp;#10;}&amp;#10;chosen_pos = key2pos.get(pressed, null);&amp;#10;is_correct = (chosen_pos.toString() === correct_key.toString());&amp;#10;bids.add_instant(&quot;choice&quot;, {&quot;onset&quot;: order_press_onset, &quot;distance_correct&quot;: distance_correct, &quot;trial_type&quot;: &quot;retr_order&quot;, &quot;block_name&quot;: block, &quot;sequence_name&quot;: learningSeq, &quot;trial_num&quot;: retrieval_trials.thisN, &quot;response&quot;: (responded_retr ? resp.keys : &quot;m&quot;), &quot;response_time&quot;: (responded_retr ? resp.rt : null), &quot;correct&quot;: is_correct, &quot;expected_response&quot;: correct_key, &quot;response_meaning&quot;: order_resp_meaning});&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="&amp;#10;# response neeeds to be saved at end of trial&amp;#10;pressed = resp.keys&amp;#10;if isinstance(pressed, list):&amp;#10;    pressed = pressed[-1] if pressed else &quot;m&quot;&amp;#10;&amp;#10;chosen_pos  = key2pos.get(pressed, None)&amp;#10;is_correct = (str(chosen_pos) == str(correct_key))&amp;#10;# changed!!&amp;#10;bids.add_instant(&amp;#10;&quot;choice&quot;,&amp;#10;onset=order_press_onset,&amp;#10;distance_correct = distance_correct,&amp;#10;trial_type = &quot;retr_order&quot;,&amp;#10;block_name=block,&amp;#10;sequence_name=learningSeq,&amp;#10;trial_num=retrieval_trials.thisN,&amp;#10;response=(resp.keys if responded_retr else &quot;m&quot;),&amp;#10;response_time=(resp.rt if responded_retr else None),&amp;#10;correct=is_correct,&amp;#10;expected_response = correct_key, &amp;#10;response_meaning=order_resp_meaning,&amp;#10;&amp;#10;)&amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
