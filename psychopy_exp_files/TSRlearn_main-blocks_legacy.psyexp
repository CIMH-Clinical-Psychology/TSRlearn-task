        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    yes_txt.text = &quot;yes&quot;;&amp;#10;    no_txt.text = &quot;no&quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    yes_txt.text = &quot;ja&quot;;&amp;#10;    no_txt.text = &quot;nein&quot;;&amp;#10;}&amp;#10;if ((language === &quot;french&quot;)) {&amp;#10;    yes_txt.text = &quot;oui&quot;;&amp;#10;    no_txt.text = &quot;non&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
