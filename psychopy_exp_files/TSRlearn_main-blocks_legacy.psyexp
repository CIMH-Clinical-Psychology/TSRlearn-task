        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    InstructionsText.text = &quot;In this task, you are to press the SPACEBAR as quick as possible after a red counter appears on screen.\n\nStart the task by pressing the RETURN key.&quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    InstructionsText.text = &quot;In diese Phase der Aufgabe, wird ein roter Counter auf dem Bildschirm erscheinen.\nDr\u00fccken Sie die LEERTASTE, sobald der Counter erscheint.\n\nDr\u00fccken Sie die EINGABETASTE, um zu starten.&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
