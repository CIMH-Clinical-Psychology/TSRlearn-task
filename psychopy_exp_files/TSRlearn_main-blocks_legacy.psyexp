        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    instruction_info.text = &quot;In the practice of the retrieval trials, you will get some background information on how the sequence of images is structured.\nThis will appear at the bottom.\n\nIn the main trials, there will be no additional information.\nYou should extract this information from the pairwise associations learned.\n\nPress any key to continue.&quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    instruction_info.text = &quot;In den \u00dcbungsdurchg\u00e4ngen erhalten Sie unten\nauf dem Bildschirm zus\u00e4tzliche Hinweise zur Struktur\nder Bildsequenz.\n\nIn der Hauptaufgabe werden diese Hinweise nicht\nmehr angezeigt. Dort m\u00fcssen Sie die Struktur aus\nden gelernten Bildpaaren ableiten.\n\nDr\u00fccken Sie eine beliebige Taste, um fortzufahren.&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="&amp;#10;if language == &quot;english&quot;: &amp;#10;    instruction_info.text = (&amp;#10;    &quot;In the practice of the retrieval trials, you will get some background information on how the sequence of images is structured.\n&quot;&amp;#10;    &quot;This will appear at the bottom.\n\nIn the main trials, there will be no additional information.\n&quot; &amp;#10;    &quot;You should extract this information from the pairwise associations learned.\n\n&quot;&amp;#10;    &quot;Press any key to continue.&quot;&amp;#10;)  &amp;#10;if language == &quot;german&quot;: &amp;#10;    instruction_info.text = (&amp;#10;&quot;In den Übungsdurchgängen erhalten Sie unten\n&quot;&amp;#10;&quot;auf dem Bildschirm zusätzliche Hinweise zur Struktur\n&quot;&amp;#10;&quot;der Bildsequenz.\n\n&quot;&amp;#10;&quot;In der Hauptaufgabe werden diese Hinweise nicht\n&quot;&amp;#10;&quot;mehr angezeigt. Dort müssen Sie die Struktur aus\n&quot;&amp;#10;&quot;den gelernten Bildpaaren ableiten.\n\n&quot;&amp;#10;&quot;Drücken Sie eine beliebige Taste, um fortzufahren.&quot;&amp;#10;&amp;#10;)  " valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
