        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="# break start&amp;#10;break_start_trig = trigger_dict[&quot;task_break_begin&quot;]&amp;#10;if frameN == 0:&amp;#10;    bids.trigger(break_start_trig, stim=break_instruction, label=&quot;task_break_start&quot;)" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="break_start_trig = trigger_dict[&quot;task_break_begin&quot;];&amp;#10;if ((frameN === 0)) {&amp;#10;    bids.trigger(break_start_trig, {&quot;stim&quot;: break_instruction, &quot;label&quot;: &quot;task_break_start&quot;});&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="break_end_trig = trigger_dict[&quot;task_break_end&quot;];&amp;#10;if ((run_break &amp;&amp; (! end_trig_send))) {&amp;#10;    bids.trigger(break_end_trig, {&quot;label&quot;: &quot;task_break_end&quot;, &quot;on_flip&quot;: false});&amp;#10;    end_trig_send = true;&amp;#10;    core.wait(0.01);&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
