        <Param val="responded_retr_slider = False&amp;#10;delayClock = None&amp;#10;delayDone = False&amp;#10;chosenDis = None&amp;#10;is_correct = False&amp;#10;chosen_num = None&amp;#10;dist_press_onset = None" valType="extendedCode" updates="constant" name="Begin Routine"/>
