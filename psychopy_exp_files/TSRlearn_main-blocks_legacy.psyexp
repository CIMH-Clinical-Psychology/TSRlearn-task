        <Param val="&amp;#10;window.prc_fdbackClock = new util.Clock();&amp;#10;window.prc_fdbackClock.reset();" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="prc_fdbackClock = core.Clock()&amp;#10;prc_fdbackClock.reset()" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="if prc_fdbackClock.getTime() &gt;= max_read_dur:&amp;#10;    # Timeout&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="if (prc_fdbackClock.getTime() &gt;= max_read_dur) {&amp;#10;    // Timeout&amp;#10;    continueRoutine = false;&amp;#10;} &amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
