        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    instructions_choose_2.text = &quot;Choose the next image in the sequence with the keys. &quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    instructions_choose_2.text = &quot;W\u00e4hlen Sie das n\u00e4chste Bild in der Sequenz.&quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language == &quot;english&quot;: &amp;#10;    instructions_choose_2.text = (&quot;Choose the next image in the sequence with the keys. &quot;)&amp;#10;if language == &quot;german&quot;: &amp;#10;    instructions_choose_2.text = (&quot;Wählen Sie das nächste Bild in der Sequenz.&quot;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
