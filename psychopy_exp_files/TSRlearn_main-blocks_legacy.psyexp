0;    delayDone = True&amp;#10;    continueRoutine = False&amp;#10;&amp;#10;if not responded_retr_slider and retrClock.getTime() &gt;= (retr_dur_slider-1):&amp;#10;    chooseNowText_3.setOpacity(1)&amp;#10;    &amp;#10;if retrClock.getTime() &gt;= retr_dur_slider and not responded_retr_slider:&amp;#10;    continueRoutine = False" valType="extendedCode" updates="constant" name="Each Frame"/>
