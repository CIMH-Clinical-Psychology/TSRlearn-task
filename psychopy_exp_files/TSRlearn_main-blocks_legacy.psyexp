        <Param val="retr_trig_sent = false;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="&amp;#10;retr_trig_sent = False&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="RespTrig = trigger_dict[&quot;order_retrieval_response&quot;]&amp;#10;if not retr_trig_sent and resp.keys:&amp;#10;    retr_trig_sent = True&amp;#10;    bids.trigger(RespTrig, label=&quot;order_response&quot;, on_flip=False,&amp;#10;                 block_name=block, sequence_name=learningSeq,&amp;#10;                 trial_num=retrieval_trials.thisN)&amp;#10;    core.wait(0.01) # need to wait a bit to avoid overlap with question trigger&amp;#10;&amp;#10;&amp;#10;           &amp;#10;&amp;#10;" valType="extendedCode" updates="constant" name="Each Frame"/>
