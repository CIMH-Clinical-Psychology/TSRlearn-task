    <Routine name="remember_story_instruction">
      <RoutineSettingsComponent name="remember_story_instruction" plugin="None">
        <Param val="none" valType="str" updates="None" name="backgroundFit"/>
        <Param val="" valType="str" updates="None" name="backgroundImg"/>
        <Param val="$[0,0,0]" valType="color" updates="None" name="color"/>
        <Param val="rgb" valType="str" updates="None" name="colorSpace"/>
        <Param val="" valType="str" updates="constant" name="desc"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="" valType="code" updates="None" name="durationEstim"/>
        <Param val="False" valType="code" updates="None" name="forceNonSlip"/>
        <Param val="remember_story_instruction" valType="code" updates="None" name="name"/>
        <Param val="True" valType="bool" updates="None" name="saveStartStop"/>
        <Param val="" valType="code" updates="constant" name="skipIf"/>
        <Param val="duration (s)" valType="str" updates="None" name="stopType"/>
        <Param val="" valType="code" updates="constant" name="stopVal"/>
        <Param val="False" valType="bool" updates="None" name="useWindowParams"/>
      </RoutineSettingsComponent>
      <CodeComponent name="story_whole_instruction" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="story_instr = {&quot;german&quot;: [&quot;Sie sehen nun die Hintergrundbilder aus der Aufgabe noch einmal. Jedes Hintergrundbild wird einmal gezeigt, danach erscheint ein Fixationskreuz.\n\nSolange das Kreuz zu sehen ist (15 Sekunden), erinnern Sie sich bitte an die Geschichte, die Sie sich beim Lernen ausgedacht haben, um sich die Bildsequenz zu diesem Hintergrundbild zu merken.\n\n[Dr\u00fccken Sie eine beliebige Taste, um fortzufahren.]&quot;, &quot;W\u00e4hrend der 15 Sekunden:\n\n\u2022 Gehen Sie die Geschichte vom Anfang bis zum Ende durch, in der Reihenfolge der Bilder.\n\n\u2022 Wenn Sie am Ende angekommen sind, bevor das Kreuz verschwindet, beginnen Sie die Geschichte wieder von vorn.\n\n[Dr\u00fccken Sie eine beliebige Taste, um fortzufahren.]&quot;, &quot;\u2022 Wenn Ihnen ein Teil der Geschichte nicht einf\u00e4llt, machen Sie mit dem n\u00e4chsten Teil weiter, an den Sie sich erinnern.\n\nSchauen Sie dabei auf das Kreuz und denken Sie an nichts anderes.\n\n[Dr\u00fccken Sie eine beliebige Taste, wenn Sie bereit sind.]&quot;], &quot;english&quot;: [&quot;You will now see the background images from the task again. Each background image is shown once, followed by a fixation cross.\n\nWhile the cross is on screen (15 seconds), recall the story you made up during learning to remember the image sequence for this background image.\n\n[Press any key to continue.]&quot;, &quot;During the 15 seconds:\n\n\u2022 Go through the story from beginning to end, in the order of the images.\n\n\u2022 If you reach the end before the cross disappears, start the story again from the beginning.\n\n[Press any key to continue.]&quot;, &quot;\u2022 If you cannot remember part of the story, continue with the next part you remember.\n\nKeep your eyes on the cross and do not think about anything else.\n\n[Press any key when you are ready.]&quot;], &quot;french&quot;: [&quot;Vous allez revoir les images de fond de la t\u00e2che. Chaque image de fond est pr\u00e9sent\u00e9e une fois, puis une croix de fixation appara\u00eet.\n\nTant que la croix est affich\u00e9e (15 secondes), rappelez-vous l\u2019histoire que vous avez invent\u00e9e pendant l\u2019apprentissage pour m\u00e9moriser la s\u00e9quence d\u2019images associ\u00e9e \u00e0 cette image de fond.\n\n[Appuyez sur une touche pour continuer.]&quot;, &quot;Pendant les 15 secondes :\n\n\u2022 Parcourez l\u2019histoire du d\u00e9but \u00e0 la fin, dans l\u2019ordre des images.\n\n\u2022 Si vous arrivez \u00e0 la fin avant que la croix ne disparaisse, recommencez l\u2019histoire depuis le d\u00e9but.\n\n[Appuyez sur une touche pour continuer.]&quot;, &quot;\u2022 Si vous ne vous souvenez plus d\u2019une partie de l\u2019histoire, continuez avec la partie suivante dont vous vous souvenez.\n\nGardez les yeux sur la croix et ne pensez \u00e0 rien d\u2019autre.\n\n[Appuyez sur une touche lorsque vous \u00eates pr\u00eat(e).]&quot;]};&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="story_instr = {&amp;#10;    &quot;german&quot;: [&amp;#10;        &quot;Sie sehen nun die Hintergrundbilder aus der Aufgabe noch einmal. &quot;&amp;#10;        &quot;Jedes Hintergrundbild wird einmal gezeigt, danach erscheint ein Fixationskreuz.\n\n&quot;&amp;#10;        &quot;Solange das Kreuz zu sehen ist (15 Sekunden), erinnern Sie sich bitte an die Geschichte, &quot;&amp;#10;        &quot;die Sie sich beim Lernen ausgedacht haben, um sich die Bildsequenz zu diesem &quot;&amp;#10;        &quot;Hintergrundbild zu merken.\n\n&quot;&amp;#10;        &quot;[Drücken Sie eine beliebige Taste, um fortzufahren.]&quot;,&amp;#10;&amp;#10;        &quot;Während der 15 Sekunden:\n\n&quot;&amp;#10;        &quot;• Gehen Sie die Geschichte vom Anfang bis zum Ende durch, in der Reihenfolge der Bilder.\n\n&quot;&amp;#10;        &quot;• Wenn Sie am Ende angekommen sind, bevor das Kreuz verschwindet, beginnen Sie die &quot;&amp;#10;        &quot;Geschichte wieder von vorn.\n\n&quot;&amp;#10;        &quot;[Drücken Sie eine beliebige Taste, um fortzufahren.]&quot;,&amp;#10;&amp;#10;        &amp;#10;        &quot;• Wenn Ihnen ein Teil der Geschichte nicht einfällt, machen Sie mit dem nächsten Teil &quot;&amp;#10;        &quot;weiter, an den Sie sich erinnern.\n\n&quot;&amp;#10;        &quot;Schauen Sie dabei auf das Kreuz und denken Sie an nichts anderes.\n\n&quot;&amp;#10;        &quot;[Drücken Sie eine beliebige Taste, wenn Sie bereit sind.]&quot;,&amp;#10;    ],&amp;#10;    &quot;english&quot;: [&amp;#10;        &quot;You will now see the background images from the task again. &quot;&amp;#10;        &quot;Each background image is shown once, followed by a fixation cross.\n\n&quot;&amp;#10;        &quot;While the cross is on screen (15 seconds), recall the story you made up during learning &quot;&amp;#10;        &quot;to remember the image sequence for this background image.\n\n&quot;&amp;#10;        &quot;[Press any key to continue.]&quot;,&amp;#10;&amp;#10;        &quot;During the 15 seconds:\n\n&quot;&amp;#10;        &quot;• Go through the story from beginning to end, in the order of the images.\n\n&quot;&amp;#10;        &quot;• If you reach the end before the cross disappears, start the story again from the beginning.\n\n&quot;&amp;#10;        &quot;[Press any key to continue.]&quot;,&amp;#10;&amp;#10;        &quot;• If you cannot remember part of the story, continue with the next part you remember.\n\n&quot;&amp;#10;        &quot;Keep your eyes on the cross and do not think about anything else.\n\n&quot;&amp;#10;        &quot;[Press any key when you are ready.]&quot;,&amp;#10;    ],&amp;#10;    &quot;french&quot;: [&amp;#10;        &quot;Vous allez revoir les images de fond de la tâche. &quot;&amp;#10;        &quot;Chaque image de fond est présentée une fois, puis une croix de fixation apparaît.\n\n&quot;&amp;#10;        &quot;Tant que la croix est affichée (15 secondes), rappelez-vous l’histoire que vous avez &quot;&amp;#10;        &quot;inventée pendant l’apprentissage pour mémoriser la séquence d’images associée à cette &quot;&amp;#10;        &quot;image de fond.\n\n&quot;&amp;#10;        &quot;[Appuyez sur une touche pour continuer.]&quot;,&amp;#10;&amp;#10;        &quot;Pendant les 15 secondes :\n\n&quot;&amp;#10;        &quot;• Parcourez l’histoire du début à la fin, dans l’ordre des images.\n\n&quot;&amp;#10;       &quot;• Si vous arrivez à la fin avant que la croix ne disparaisse, recommencez l’histoire &quot;&amp;#10;        &quot;depuis le début.\n\n&quot;&amp;#10;        &quot;[Appuyez sur une touche pour continuer.]&quot;,&amp;#10;&amp;#10;&amp;#10;        &quot;• Si vous ne vous souvenez plus d’une partie de l’histoire, continuez avec la partie &quot;&amp;#10;        &quot;suivante dont vous vous souvenez.\n\n&quot;&amp;#10;        &quot;Gardez les yeux sur la croix et ne pensez à rien d’autre.\n\n&quot;&amp;#10;        &quot;[Appuyez sur une touche lorsque vous êtes prêt(e).]&quot;,&amp;#10;    ],&amp;#10;}" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
