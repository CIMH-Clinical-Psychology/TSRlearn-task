        <Param val="if language == &quot;english&quot;:&amp;#10;    text_which_sequence.text = &quot;Think about the associated image sequence!&quot;&amp;#10;elif language == &quot;german&quot;:&amp;#10;    text_which_sequence.text = &quot;Denken Sie an die zugehörige Bildsequenz!&quot;&amp;#10;elif language == &quot;french&quot;:&amp;#10;    text_which_sequence.text = &quot;Pensez à la séquence d’images associée !&quot;" valType="extendedCode" updates="constant" name="Begin Routine"/>
