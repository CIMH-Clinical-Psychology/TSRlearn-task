        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    question_fastseq_text.text = &quot;Which position did this image appear in? Use the left and right keys to move the slider, then press the upper (red) key to confirm your response.&quot;;&amp;#10;} else {&amp;#10;    if ((language === &quot;german&quot;)) {&amp;#10;        question_fastseq_text.text = &quot;An welcher Position ist dieses Bild erschienen? Bewegen Sie den Schieberegler mit der linken und rechten Taste und best\u00e4tigen Sie Ihre Antwort mit der oberen (roten) Taste.&quot;;&amp;#10;    } else {&amp;#10;        if ((language === &quot;french&quot;)) {&amp;#10;            question_fastseq_text.text = &quot;\u00c0 quelle position cette image est-elle apparue ? D\u00e9placez le curseur avec les touches gauche et droite, puis appuyez sur la touche du haut (rouge) pour valider votre r\u00e9ponse.&quot;;&amp;#10;        }&amp;#10;    }&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if language == &quot;english&quot;:&amp;#10;    question_fastseq_text.text = (&amp;#10;        &quot;Which position did this image appear in? &quot;&amp;#10;        &quot;Use the left and right keys to move the slider, &quot;&amp;#10;        &quot;then press the upper (red) key to confirm your response.&quot;)&amp;#10;elif language == &quot;german&quot;:&amp;#10;    question_fastseq_text.text = (&amp;#10;        &quot;An welcher Position ist dieses Bild erschienen? &quot;&amp;#10;        &quot;Bewegen Sie den Schieberegler mit der linken und rechten Taste &quot;&amp;#10;        &quot;und bestätigen Sie Ihre Antwort mit der oberen (roten) Taste.&quot;)&amp;#10;elif language == &quot;french&quot;:&amp;#10;    question_fastseq_text.text = (&amp;#10;        &quot;À quelle position cette image est-elle apparue ? &quot;&amp;#10;        &quot;Déplacez le curseur avec les touches gauche et droite, &quot;&amp;#10;        &quot;puis appuyez sur la touche du haut (rouge) pour valider votre réponse.&quot;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
