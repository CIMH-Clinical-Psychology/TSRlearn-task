        <Param val="font_name = &quot;Open Sans&quot;&amp;#10;font_size = 0.03&amp;#10;&amp;#10;language = &quot;german&quot; &amp;#10;left_key =&quot;g&quot;&amp;#10;up_key = &quot;r&quot;&amp;#10;right_key = &quot;b&quot;&amp;#10;down_key = &quot;y&quot;&amp;#10;&amp;#10;allowed_keys = [left_key, up_key, right_key, down_key]&amp;#10;&amp;#10;fast_img_dur = 0.112 # [s]&amp;#10;mask_dur = 0.048 # [s]&amp;#10;fast_img_repetitions = 30" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="font_name = &quot;Open Sans&quot;;&amp;#10;font_size = 0.03;&amp;#10;language = &quot;german&quot;;&amp;#10;left_key = &quot;g&quot;;&amp;#10;up_key = &quot;r&quot;;&amp;#10;right_key = &quot;b&quot;;&amp;#10;down_key = &quot;y&quot;;&amp;#10;allowed_keys = [left_key, up_key, right_key, down_key];&amp;#10;fast_img_dur = 0.112;&amp;#10;mask_dur = 0.048;&amp;#10;fast_img_repetitions = 30;&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
