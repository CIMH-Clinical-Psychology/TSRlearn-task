        <Param val="if (key_resp_2) {&amp;#10;    bids.add_instant(&quot;fastseq_resp&quot;, {&quot;trial_type&quot;: &quot;fast_seq&quot;, &quot;trial_num&quot;: repeats_fastseq.thisN, &quot;response&quot;: (key_resp_2.keys ? key_resp_2.keys : &quot;m&quot;), &quot;response_time&quot;: ((&quot;rt&quot; in key_resp_2) ? key_resp_2.rt : null), &quot;correct&quot;: (Number.parseInt(probe_position) === Number.parseInt(key_resp_2.keys)), &quot;expected_response&quot;: probe_position});&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="&amp;#10;if key_resp_2:&amp;#10;    bids.add_instant(&amp;#10;    &quot;fastseq_resp&quot;,&amp;#10;    trial_type = &quot;fast_seq&quot;,&amp;#10;    trial_num=repeats_fastseq.thisN,&amp;#10;    response=(key_resp_2.keys if key_resp_2.keys else &quot;m&quot;),&amp;#10;    response_time=(key_resp_2.rt if hasattr(key_resp_2, &quot;rt&quot;) else None),&amp;#10;    correct=(int(probe_position)==int(key_resp_2.keys)),&amp;#10;    expected_response = probe_position, &amp;#10;)&amp;#10;&amp;#10;    &amp;#10;" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
