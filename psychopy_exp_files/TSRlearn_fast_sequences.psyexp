        <Param val="send_trigger({&quot;value&quot;: trigger_numbers_dict[&quot;start/end&quot;]});&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="&amp;#10;send_trigger(value=trigger_numbers_dict[&quot;start/end&quot;])" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
