        <Param val="bids.schedule_onset(instruction_part7,&amp;#10;                        type_of_stimulus=&quot;instructions&quot;,&amp;#10;                        component_label=&quot;instruction_part7&quot;)" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="bids.schedule_onset(instruction_part7, {&quot;type_of_stimulus&quot;: &quot;instructions&quot;, &quot;component_label&quot;: &quot;instruction_part7&quot;});&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
