        <Param val="Auto-&gt;JS" valType="str" updates="None" name="Code Type"/>
        <Param val="keys_now = key_resp_2.keys if isinstance(key_resp_2.keys, list) else []&amp;#10;for i in range(slider_keys_done, len(keys_now)):&amp;#10;    key = keys_now[i]&amp;#10;    if key == left_key:&amp;#10;        slider.markerPos = max(1, slider.markerPos - 1)&amp;#10;        slider_n_moves += 1&amp;#10;    elif key == right_key:&amp;#10;        slider.markerPos = min(5, slider.markerPos + 1)&amp;#10;        slider_n_moves += 1&amp;#10;    elif key == up_key:&amp;#10;        fastseq_rt = key_resp_2.rt[i]                     # keyboard timestamp of the up press&amp;#10;        slider.recordRating(slider.markerPos, rt=fastseq_rt)&amp;#10;        continueRoutine = False&amp;#10;        break&amp;#10;slider_keys_done = len(keys_now)" valType="extendedCode" updates="constant" name="Each Frame"/>
