        <Param val="if ((language === &quot;english&quot;)) {&amp;#10;    instruction_part7.text = &quot;You finished the last task block. Good job!\nPress any key to end this part of the experiment. &quot;;&amp;#10;}&amp;#10;if ((language === &quot;german&quot;)) {&amp;#10;    instruction_part7.text = &quot;Sie haben den letzten Aufgabenblock abgeschlossen. Gut gemacht!\nDr\u00fccken Sie eine beliebige Taste, um diesen Teil des Experiments zu beenden.&quot;;&amp;#10;}&amp;#10;if ((language === &quot;french&quot;)) {&amp;#10;    instruction_part7.text = &quot;Vous avez termin\u00e9 la derni\u00e8re partie des exercices. Bravo!\nAppuyez sur une touche pour terminer cette partie de l'exp\u00e9rience. &quot;;&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
