        <Param val="bids.schedule_onset(instruction_begin, {&quot;type_of_stimulus&quot;: &quot;instructions&quot;, &quot;component_label&quot;: &quot;instruction_part1&quot;});&amp;#10;" valType="extendedCode" updates="constant" name="Each JS Frame"/>
